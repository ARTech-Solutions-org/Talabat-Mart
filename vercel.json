{
  "version": 2,
  "installCommand": "pnpm install",
  "buildCommand": "PORT=3000 BASE_PATH=/ pnpm --filter @workspace/memory-booth run build",
  "outputDirectory": "artifacts/memory-booth/dist/public",
  "functions": {
    "api/**/*": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/ar.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/mindar-image-three.prod.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/targets.mind",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/ar.html",
      "destination": "/ar.html"
    },
    {
      "source": "/mindar-image-three.prod.js",
      "destination": "/mindar-image-three.prod.js"
    },
    {
      "source": "/targets.mind",
      "destination": "/targets.mind"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}