{
  "version": 2,
  "installCommand": "pnpm install",
  "buildCommand": "PORT=3000 BASE_PATH=/ pnpm --filter @workspace/memory-booth run build",
  "outputDirectory": "artifacts/memory-booth/dist/public",
  "functions": {
    "api/**/*": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/ar.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/ar.html",
      "destination": "/ar.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}